    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2002/07/owl#qualifiedCardinality -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2002/07/owl#qualifiedCardinality"/>
    


    <!-- https://spec.industrialontologies.org/ontology/annotation/abbreviation -->

    <owl:AnnotationProperty rdf:about="https://spec.industrialontologies.org/ontology/annotation/abbreviation"/>
    


    <!-- https://spec.industrialontologies.org/ontology/annotation/adaptedFrom -->

    <owl:AnnotationProperty rdf:about="https://spec.industrialontologies.org/ontology/annotation/adaptedFrom"/>
    


    <!-- https://spec.industrialontologies.org/ontology/annotation/directSource -->

    <owl:AnnotationProperty rdf:about="https://spec.industrialontologies.org/ontology/annotation/directSource"/>
    


    <!-- https://spec.industrialontologies.org/ontology/annotation/explanatoryNote -->

    <owl:AnnotationProperty rdf:about="https://spec.industrialontologies.org/ontology/annotation/explanatoryNote"/>
    


    <!-- https://spec.industrialontologies.org/ontology/annotation/informationContentEntityLocation -->

    <owl:AnnotationProperty rdf:about="https://spec.industrialontologies.org/ontology/annotation/informationContentEntityLocation">
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">information content entity location</rdfs:label>
        <iof-av:explanatoryNote xml:lang="en-US">this annotation property serves the purpose of identifying where an information content entity that is not fully stored in a knowledge graph (e.g., only its metadata is present) is located for the purpose of retrieving it to conduct non-knowledge graph analysis (e.g., PCA). In case of a file system the data should be stored as a relative path</iof-av:explanatoryNote>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">annotation property that identifies the location of an information content entity within a database, file system, or online resource</iof-av:naturalLanguageDefinition>
    </owl:AnnotationProperty>
    


    <!-- https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition -->

    <owl:AnnotationProperty rdf:about="https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition"/>
    


    <!-- https://spec.industrialontologies.org/ontology/annotation/synonym -->

    <owl:AnnotationProperty rdf:about="https://spec.industrialontologies.org/ontology/annotation/synonym"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://spec.industrialontologies.org/ontology/construct/configurationVariableOf -->

    <owl:ObjectProperty rdf:about="https://spec.industrialontologies.org/ontology/construct/configurationVariableOf">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000137"/>
        <owl:inverseOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasConfigurationVariable"/>
        <rdfs:domain rdf:resource="https://spec.industrialontologies.org/ontology/construct/ConfigurationVariable"/>
        <rdfs:range rdf:resource="https://spec.industrialontologies.org/ontology/construct/EncodedAlgorithm"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">configuration variable of</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">relation from a configuration variable to an encoded algorithm of which the configuration variable is a part</iof-av:naturalLanguageDefinition>
    </owl:ObjectProperty>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/configurationVariableSetOf -->

    <owl:ObjectProperty rdf:about="https://spec.industrialontologies.org/ontology/construct/configurationVariableSetOf">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000137"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">configuration variable set of</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">relation from a configuration variable set to an encoded algorithm to which the configuration variable set belongs</iof-av:naturalLanguageDefinition>
    </owl:ObjectProperty>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/dataInputOf -->

    <owl:ObjectProperty rdf:about="https://spec.industrialontologies.org/ontology/construct/dataInputOf">
        <rdfs:subPropertyOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/isInputOf"/>
        <owl:inverseOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasDataInput"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000027"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000100"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">data input of</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">relation from a data item or dataset to a process for which it is an input</iof-av:naturalLanguageDefinition>
    </owl:ObjectProperty>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/dataOutputOf -->

    <owl:ObjectProperty rdf:about="https://spec.industrialontologies.org/ontology/construct/dataOutputOf">
        <rdfs:subPropertyOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/isOutputOf"/>
        <owl:inverseOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasDataOutput"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000027"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000100"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">data output of</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">relation from a data item or dataset to a process for which it is an output</iof-av:naturalLanguageDefinition>
    </owl:ObjectProperty>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/describedBy -->

    <owl:ObjectProperty rdf:about="https://spec.industrialontologies.org/ontology/construct/describedBy"/>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/describes -->

    <owl:ObjectProperty rdf:about="https://spec.industrialontologies.org/ontology/construct/describes"/>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/designates -->

    <owl:ObjectProperty rdf:about="https://spec.industrialontologies.org/ontology/construct/designates"/>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/executed -->

    <owl:ObjectProperty rdf:about="https://spec.industrialontologies.org/ontology/construct/executed">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000059"/>
        <owl:inverseOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/isExecutedIn"/>
        <rdfs:domain rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
        <rdfs:range rdf:resource="https://spec.industrialontologies.org/ontology/construct/EncodedAlgorithm"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">executed</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">relates a planned process to an encoded algorithm that is concretized during the planned process</iof-av:naturalLanguageDefinition>
    </owl:ObjectProperty>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/hasComplexValueExpressionAtAllTimes -->

    <owl:ObjectProperty rdf:about="https://spec.industrialontologies.org/ontology/construct/hasComplexValueExpressionAtAllTimes">
        <rdfs:subPropertyOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasComplexValueExpressionAtSomeTime"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">has complex value expression at all times</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">relation that holds at all times between an information content entity and a complex value expression associated with it</iof-av:naturalLanguageDefinition>
    </owl:ObjectProperty>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/hasComplexValueExpressionAtSomeTime -->

    <owl:ObjectProperty rdf:about="https://spec.industrialontologies.org/ontology/construct/hasComplexValueExpressionAtSomeTime">
        <rdfs:subPropertyOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/isSubjectOf"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">has complex value expression at some time</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">relation that holds at some time between an information content entity and a complex value expression associated with it</iof-av:naturalLanguageDefinition>
    </owl:ObjectProperty>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/hasConfigurationSettingAtSomeTime -->

    <owl:ObjectProperty rdf:about="https://spec.industrialontologies.org/ontology/construct/hasConfigurationSettingAtSomeTime">
        <rdfs:subPropertyOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/describedBy"/>
        <owl:inverseOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/isConfigurationSettingOfAtSomeTime"/>
        <rdfs:domain rdf:resource="https://spec.industrialontologies.org/ontology/construct/ConfigurationVariable"/>
        <rdfs:range rdf:resource="https://spec.industrialontologies.org/ontology/construct/ConfigurationSetting"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">has configuration setting at some time</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">relation from a configuration variable to a configuration setting that specifies the value of the configuration variable at some time</iof-av:naturalLanguageDefinition>
    </owl:ObjectProperty>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/hasConfigurationSettingSetAtSomeTime -->

    <owl:ObjectProperty rdf:about="https://spec.industrialontologies.org/ontology/construct/hasConfigurationSettingSetAtSomeTime">
        <rdfs:subPropertyOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/describedBy"/>
        <owl:inverseOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/isConfigurationSettingSetOfAtSomeTime"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">has configuration setting set at some time</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">relation from a configuration variable set to a configuration setting set that specifies the values of the configuration variable set at some time</iof-av:naturalLanguageDefinition>
    </owl:ObjectProperty>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/hasConfigurationVariable -->

    <owl:ObjectProperty rdf:about="https://spec.industrialontologies.org/ontology/construct/hasConfigurationVariable">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000111"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">has configuration variable</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">relation between an encoded algorithm and a configuration variable that is part of the encoded algorithm</iof-av:naturalLanguageDefinition>
    </owl:ObjectProperty>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/hasDataInput -->

    <owl:ObjectProperty rdf:about="https://spec.industrialontologies.org/ontology/construct/hasDataInput">
        <rdfs:subPropertyOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasInput"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000027"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000100"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">has data input</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">relation from a process to a data item or dataset that is an input to the process</iof-av:naturalLanguageDefinition>
    </owl:ObjectProperty>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/hasDataOutput -->

    <owl:ObjectProperty rdf:about="https://spec.industrialontologies.org/ontology/construct/hasDataOutput">
        <rdfs:subPropertyOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasOutput"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000027"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000100"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">has data output</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">relation from a process to a data item or dataset that is an output of the process</iof-av:naturalLanguageDefinition>
    </owl:ObjectProperty>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/hasDefaultSetting -->

    <owl:ObjectProperty rdf:about="https://spec.industrialontologies.org/ontology/construct/hasDefaultSetting">
        <rdfs:subPropertyOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasConfigurationSettingAtSomeTime"/>
        <owl:inverseOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/isDefaultSettingOf"/>
        <rdfs:domain rdf:resource="https://spec.industrialontologies.org/ontology/construct/ConfigurationVariable"/>
        <rdfs:range rdf:resource="https://spec.industrialontologies.org/ontology/construct/DefaultSetting"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">has default setting</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">relation from a configuration variable to a default setting that specifies the default value of the configuration variable</iof-av:naturalLanguageDefinition>
    </owl:ObjectProperty>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/hasIndex -->

    <owl:ObjectProperty rdf:about="https://spec.industrialontologies.org/ontology/construct/hasIndex">
        <rdfs:subPropertyOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/isSubjectOf"/>
        <owl:inverseOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/isTheIndexOf"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">has index</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">relation from an information content entity to an index that determines its position within another information content entity</iof-av:naturalLanguageDefinition>
    </owl:ObjectProperty>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/hasInformationContentEntityCharacteristic -->

    <owl:ObjectProperty rdf:about="https://spec.industrialontologies.org/ontology/construct/hasInformationContentEntityCharacteristic">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/informationContentEntityCharacteristicOf"/>
        <rdfs:domain rdf:resource="https://spec.industrialontologies.org/ontology/construct/InformationContentEntity"/>
        <rdfs:range rdf:resource="https://spec.industrialontologies.org/ontology/construct/InformationContentEntityCharacteristic"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">has information content entity characteristic</rdfs:label>
        <iof-av:explanatoryNote xml:lang="en-US">relation from an information content entity to its characteristic</iof-av:explanatoryNote>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">relation from an information content entity to a characteristic of that information content entity</iof-av:naturalLanguageDefinition>
    </owl:ObjectProperty>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/hasInput -->

    <owl:ObjectProperty rdf:about="https://spec.industrialontologies.org/ontology/construct/hasInput"/>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/hasOutput -->

    <owl:ObjectProperty rdf:about="https://spec.industrialontologies.org/ontology/construct/hasOutput"/>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput -->

    <owl:ObjectProperty rdf:about="https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput"/>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/hasTargetVariable -->

    <owl:ObjectProperty rdf:about="https://spec.industrialontologies.org/ontology/construct/hasTargetVariable">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/targetVariableOf"/>
        <rdfs:domain rdf:resource="https://spec.industrialontologies.org/ontology/construct/FeatureVector"/>
        <rdfs:range rdf:resource="https://spec.industrialontologies.org/ontology/construct/TargetVariable"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">has target variable</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">relates a feature vector to a target variable that is associated with the feature vector</iof-av:naturalLanguageDefinition>
    </owl:ObjectProperty>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/informationContentEntityCharacteristicOf -->

    <owl:ObjectProperty rdf:about="https://spec.industrialontologies.org/ontology/construct/informationContentEntityCharacteristicOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://spec.industrialontologies.org/ontology/construct/InformationContentEntityCharacteristic"/>
        <rdfs:range rdf:resource="https://spec.industrialontologies.org/ontology/construct/InformationContentEntity"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">information content entity characteristic of</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">relation from an information content entity characteristic to the information content entity that has the characteristic</iof-av:naturalLanguageDefinition>
    </owl:ObjectProperty>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/informationContentEntityDerivedFrom -->

    <owl:ObjectProperty rdf:about="https://spec.industrialontologies.org/ontology/construct/informationContentEntityDerivedFrom">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://spec.industrialontologies.org/ontology/construct/InformationContentEntity"/>
        <rdfs:range rdf:resource="https://spec.industrialontologies.org/ontology/construct/InformationContentEntity"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">information content entity derived from</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">relation from an information content entity to another information content entity from which it was generated</iof-av:naturalLanguageDefinition>
    </owl:ObjectProperty>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/informationContentEntityDirectlyDerivedFrom -->

    <owl:ObjectProperty rdf:about="https://spec.industrialontologies.org/ontology/construct/informationContentEntityDirectlyDerivedFrom">
        <rdfs:subPropertyOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/informationContentEntityDerivedFrom"/>
        <rdfs:domain rdf:resource="https://spec.industrialontologies.org/ontology/construct/InformationContentEntity"/>
        <rdfs:range rdf:resource="https://spec.industrialontologies.org/ontology/construct/InformationContentEntity"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">information content entity directly derived from</rdfs:label>
        <iof-av:explanatoryNote xml:lang="en-US">A directly derived from B means that there exist no intermediary information content entity C such that C is derived from B and A is derived from C</iof-av:explanatoryNote>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">relation from an information content entity to another information content entity from which it was generated directly</iof-av:naturalLanguageDefinition>
    </owl:ObjectProperty>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/isAbout -->

    <owl:ObjectProperty rdf:about="https://spec.industrialontologies.org/ontology/construct/isAbout"/>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/isAchievedByAtSomeTime -->

    <owl:ObjectProperty rdf:about="https://spec.industrialontologies.org/ontology/construct/isAchievedByAtSomeTime"/>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/isComposedOf -->

    <owl:ObjectProperty rdf:about="https://spec.industrialontologies.org/ontology/construct/isComposedOf">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000178"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/isTheIndexAssociatedWith"/>
            </rdf:Description>
            <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/isTheIndexOf"/>
        </owl:propertyChainAxiom>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">is composed of</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">relation from an entity to a part of that entity when the part has an ordering relation with other parts of the entity</iof-av:naturalLanguageDefinition>
    </owl:ObjectProperty>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/isConfigurationSettingOfAtSomeTime -->

    <owl:ObjectProperty rdf:about="https://spec.industrialontologies.org/ontology/construct/isConfigurationSettingOfAtSomeTime">
        <rdfs:subPropertyOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/describes"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">is configuration setting of at some time</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">relation from a configuration setting to the configuration variable whose value it specifies at some time</iof-av:naturalLanguageDefinition>
    </owl:ObjectProperty>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/isConfigurationSettingSetOfAtSomeTime -->

    <owl:ObjectProperty rdf:about="https://spec.industrialontologies.org/ontology/construct/isConfigurationSettingSetOfAtSomeTime">
        <rdfs:subPropertyOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/describes"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">is configuration setting set of at some time</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">relation from a configuration setting set to the configuration variable set whose values it specifies at some time</iof-av:naturalLanguageDefinition>
    </owl:ObjectProperty>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/isDefaultSettingOf -->

    <owl:ObjectProperty rdf:about="https://spec.industrialontologies.org/ontology/construct/isDefaultSettingOf">
        <rdfs:subPropertyOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/isConfigurationSettingOfAtSomeTime"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">is default setting of</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">relation from a default setting to the configuration variable for which it specifies the default value</iof-av:naturalLanguageDefinition>
    </owl:ObjectProperty>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/isEncodedIn -->

    <owl:ObjectProperty rdf:about="https://spec.industrialontologies.org/ontology/construct/isEncodedIn">
        <rdfs:subPropertyOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/isAbout"/>
        <rdfs:domain rdf:resource="https://spec.industrialontologies.org/ontology/construct/EncodedAlgorithm"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">is encoded in</rdfs:label>
        <iof-av:adaptedFrom>http://www.ebi.ac.uk/efo/swo/SWO_0000741</iof-av:adaptedFrom>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">relation from an encoded algorithm to a programming language or framework in which the encoded algorithm was written</iof-av:naturalLanguageDefinition>
    </owl:ObjectProperty>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/isExecutedIn -->

    <owl:ObjectProperty rdf:about="https://spec.industrialontologies.org/ontology/construct/isExecutedIn">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000058"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">is executed in</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">relation from an encoded algorithm to a planned process in which the encoded algorithm is concretized or run</iof-av:naturalLanguageDefinition>
    </owl:ObjectProperty>
    


