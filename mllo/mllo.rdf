        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">training data set</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">machine learning dataset that is used as input to machine learning training</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/TypeCastingOperation -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/TypeCastingOperation">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DataProcessingOperation"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">type casting operation</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">data processing operation that casts the values of all the inputs to a particular data type</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/UnsupervisedLearning -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/UnsupervisedLearning">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningTraining"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:complementOf>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasDataInput"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/TargetVariable"/>
                    </owl:Restriction>
                </owl:complementOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000057"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningModel"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000110"/>
                                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/DataDescriptionObjective"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">unsupervised learning</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">machine learning training that is independent from any target variables</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/ValidationDataSet -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/ValidationDataSet">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningDataSet"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/dataOutputOf"/>
                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningDataSetPartitioning"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">validation data set</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">machine learning dataset that was created in some data partitioning process and is used as input for machine learning model evaluation that is part of hyperparameter tuning</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/ValueExpression -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/ValueExpression">
