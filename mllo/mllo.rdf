    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/EncodedAlgorithmCharacteristic -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/EncodedAlgorithmCharacteristic">
