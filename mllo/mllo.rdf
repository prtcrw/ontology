    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/EngineeredSystem -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/EngineeredSystem"/>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/EnsembleAlgorithm -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/EnsembleAlgorithm">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningTrainingAlgorithm"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">ensemble algorithm</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">machine learning algorithm that prescribes how to combine elements of multiple machine learning models trained on the same task in order to achieve better performance</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/Epoch -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/Epoch">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000202"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000139"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty>
                            <rdf:Description>
                                <owl:inverseOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000199"/>
                            </rdf:Description>
                        </owl:onProperty>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningTraining"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">epoch</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">time interval during which a whole machine learning input dataset is processed in a machine learning training</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/EpochNumber -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/EpochNumber">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/Hyperparameter"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">epoch number</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">hyperparameter that specifies the number of epochs a machine learning model will be trained for</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/ExploratoryDataAnalysis -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/ExploratoryDataAnalysis">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasDataInput"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/IAO_0000100"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/DataItemCharacteristic"/>
                            <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/DataSetCharacteristic"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">exploratory data analysis</rdfs:label>
        <skos:example xml:lang="en-US">determining the correlation between feature vectors, determining the skewness of the distribution of a particular feature</skos:example>
        <iof-av:explanatoryNote xml:lang="en-US">typically precedes machine learning data preparation</iof-av:explanatoryNote>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">planned process in which one or more characteristics of a dataset or its parts are determined</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/Feature -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/Feature">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000027"/>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000177"/>
                                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningDataSet"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty>
                                    <rdf:Description>
                                        <owl:inverseOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/informationContentEntityDerivedFrom"/>
                                    </rdf:Description>
                                </owl:onProperty>
                                <owl:someValuesFrom>
                                    <owl:Class>
                                        <owl:intersectionOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000027"/>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000177"/>
                                                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningDataSet"/>
                                            </owl:Restriction>
                                        </owl:intersectionOf>
                                    </owl:Class>
                                </owl:someValuesFrom>
                            </owl:Restriction>
                        </owl:unionOf>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">feature</rdfs:label>
        <skos:example xml:lang="en-US">petal width value of an iris flower; digital image of a number</skos:example>
        <iof-av:explanatoryNote xml:lang="en-US">1. the data item considered as feature can be used directly in machine learning training or can first undergo a series of machine learning data preparation operations (e.g., feature engineering or data cleaning)

2. association here can be interpreted as the feature being about some aspect or characteristic of the entity

3. Feature can also in some cases be interpreted as a single item (entry) within a machine learning dataset</iof-av:explanatoryNote>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">data item associated with an entity and intended to be used as input to a machine learning model execution or machine learning training</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/FeatureCharacteristic -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/FeatureCharacteristic">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/informationContentEntityCharacteristicOf"/>
                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/Feature"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DataItemCharacteristic"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">feature characteristic</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">data item characteristic of a feature</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/FeatureColumn -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/FeatureColumn">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000100"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isComposedOf"/>
                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/Feature"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isComposedOf"/>
                <owl:allValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/Feature"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">feature column</rdfs:label>
        <skos:example xml:lang="en-US">petal length value of 50 different iris flowers</skos:example>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">dataset that is composed of a number of features of the same type that are associated with different entities</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/FeatureDecomposition -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/FeatureDecomposition">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/FeatureEngineeringOperation"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">feature decomposition</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">feature engineering operation that creates multiple features from one feature</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/FeatureEngineeringAlgorithm -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/FeatureEngineeringAlgorithm">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DataProcessingAlgorithm"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/prescribes"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/EncodedAlgorithm"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isExecutedIn"/>
                                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/FeatureEngineeringOperation"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">feature engineering algorithm</rdfs:label>
        <skos:example xml:lang="en-US">min-max normalization algorithm that scales all the features to a specific range</skos:example>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">data processing algorithm that prescribes how to generate a feature of a particular type from a set of inputs</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/FeatureEngineeringOperation -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/FeatureEngineeringOperation">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/DataProcessingOperation"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/executed"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/EncodedFeatureEngineeringAlgorithm"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DataProcessingOperation"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">feature engineering operation</rdfs:label>
        <skos:example xml:lang="en-US">min-max normalization of a numerical feature vector; bagging transformation of a textual feature</skos:example>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">planned process in which one or more input features are used to create derived features</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/FeatureEngineeringPipeline -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/FeatureEngineeringPipeline">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DataProcessingPipeline"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000117"/>
                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/FeatureEngineeringOperation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasDataOutput"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000100"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isComposedOf"/>
                                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/DerivedFeatureColumn"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">feature engineering pipeline</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">planned process that consists of a number of feature engineering operations and that outputs a dataset that has at least one derived feature column as part</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/FeatureEngineeringTransformation -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/FeatureEngineeringTransformation">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/FeatureEngineeringOperation"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">feature engineering transformation</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">feature engineering operation that changes the representation or value of a feature</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/FeatureGeneration -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/FeatureGeneration">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/FeatureEngineeringOperation"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">feature generation</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">feature engineering operation that generates one or more features by combining multiple features</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/FeatureScalingAlgorithm -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/FeatureScalingAlgorithm">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/FeatureEngineeringAlgorithm"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">feature scaling algorithm</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">feature engineering algorithm that prescribes how to scale a feature vector or feature to be within a particular value range</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/FeatureScalingOperation -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/FeatureScalingOperation">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/FeatureEngineeringTransformation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasDataOutput"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/ScaledFeature"/>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/DerivedFeatureColumn"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isComposedOf"/>
                                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/ScaledFeature"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">feature scaling operation</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">feature engineering transformation that produced scaled features as its output</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/FeatureSelection -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/FeatureSelection">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000117"/>
                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningTraining"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000117"/>
                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/ModelEvaluation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasDataInput"/>
                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningDataSet"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasDataOutput"/>
                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningDataSet"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">feature selection</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">planned process in which a subset of initial features is selected such that the associated machine learning model has a more optimal performance</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/FeatureVector -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/FeatureVector">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000100"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isComposedOf"/>
                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/Feature"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isComposedOf"/>
                <owl:allValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/Feature"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/describes"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">feature vector</rdfs:label>
        <skos:example xml:lang="en-US">petal length value, petal width value, sepal length value and sepal width value associated with a single iris flower</skos:example>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">dataset composed of a set of features that belong to a single entity</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/FeatureVectorCharacteristic -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/FeatureVectorCharacteristic">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/informationContentEntityCharacteristicOf"/>
                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/FeatureVector"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DataSetCharacteristic"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">feature vector characteristic</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">dataset characteristic of a feature vector</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/FlatteningLayer -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/FlatteningLayer">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/NeuralNetworkLayer"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">flattening layer</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">neural network layer that transforms multidimensional input data into a one-dimensional array to prepare the data for input to fully connected layers</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/FullyConnectedLayer -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/FullyConnectedLayer">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/NeuralNetworkLayer"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">fully connected layer</rdfs:label>
        <iof-av:explanatoryNote xml:lang="en-US">in case the FC layer is the input layer, then each node directly takes as inputs all the entries of an individual feature vector</iof-av:explanatoryNote>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">neural network layer in which each node connects directly to all nodes from a previous layer</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/GaussianNoise -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/GaussianNoise">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/Noise"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">gaussian noise</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">noise whose values follow a gaussian distribution</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/GaussianProcessRegression -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/GaussianProcessRegression">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/NonParametricModel"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">gaussian process regression</rdfs:label>
        <iof-av:explanatoryNote xml:lang="en-US">gaussian process regression is trained by a bayesian algorithm in a supervised learning process where a gaussian process prior is used as input</iof-av:explanatoryNote>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">non-parametric model which is a gaussian process distribution over possible functions that model the underlying data</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/Graph -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/Graph">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/InformationContentEntity"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000027"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000100"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">graph</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">data item or dataset that consists of a set of nodes that are connected with edges</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/GraphFeature -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/GraphFeature">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/Feature"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/describes"/>
                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/Graph"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">graph feature</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">feature of a graph</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/GroupOfMachineLearningModels -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/GroupOfMachineLearningModels">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/InformationContentEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000110"/>
                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningModel"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">group of machine learning models</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">collection of machine learning models</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/HammingLoss -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/HammingLoss">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PerformanceMetric"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">hamming loss</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">performance metric that prescribes how to quantify the fraction of incorrect labels assigned to a set of machine learning inputs</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/Hyperparameter -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/Hyperparameter">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/ConfigurationVariable"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/configurationVariableOf"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/EncodedMachineLearningTrainingAlgorithm"/>
                            <owl:Restriction>
                                <owl:onProperty>
                                    <rdf:Description>
                                        <owl:inverseOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/isComposedOf"/>
                                    </rdf:Description>
                                </owl:onProperty>
                                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/EncodedMachineLearningTrainingAlgorithm"/>
                            </owl:Restriction>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningParameter"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">hyperparameter</rdfs:label>
        <skos:example xml:lang="en-US">number of epochs for training a neural network model</skos:example>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">configuration variable of an encoded machine learning algorithm whose value is not influenced directly by data during machine learning training</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/HyperparameterSet -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/HyperparameterSet">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/ConfigurationVariableSet"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">hyperparameter set</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">collection of hyperparameters that belong to a particular machine learning training implementation</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/HyperparameterTuning -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/HyperparameterTuning">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000117"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/ModelValidation"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/ConfigurationVariableSettingSet"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isConfigurationSettingSetOfAtSomeTime"/>
                                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/HyperparameterSet"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">hyperparameter tuning</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">planned process in which an optimal hyperparameter value set is found by a set of model validations, whereby machine learning training in each model validation has different hyperparameter values as inputs</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/Identifier -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/Identifier"/>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/ImageFeature -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/ImageFeature">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/Feature"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/describes"/>
                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/DigitalImage"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">image feature</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">feature of a digital image</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/Index -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/Index">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/InformationContentEntity"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">index</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">information content entity that is the position of an information content entity within another information content entity</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/InformationContentEntity -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/InformationContentEntity"/>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/InformationContentEntityCharacteristic -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/InformationContentEntityCharacteristic">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/informationContentEntityCharacteristicOf"/>
                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/InformationContentEntity"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/InformationContentEntity"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">information content entity characteristic</rdfs:label>
        <skos:example xml:lang="en-US">skewness in the distribution of a feature, collinearity between different feature vectors, capability of a model to handle non-linear data, depth of a machine learning model, class entropy of a categorical dataset</skos:example>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">distinguishing quality or property of an information content entity</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/InformationContentEntityOrderingScheme -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/InformationContentEntityOrderingScheme">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/InformationContentEntity"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">information content entity ordering scheme</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">information content entity that prescribes the ordering between elements of which an information content entity is composed of</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/InitialMachineLearningParameterSetting -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/InitialMachineLearningParameterSetting">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningParameterSetting"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isInputOf"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningTraining"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningParameterSetting"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">initial machine learning parameter setting</rdfs:label>
        <skos:example xml:lang="en-US">value of a neuron weight that is the output of machine learning parameter initialization and the input of training of the neural network the neuron is a part of</skos:example>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">machine learning parameter setting at the beginning of some machine learning training</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/InitialMachineLearningParameterSettingSet -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/InitialMachineLearningParameterSettingSet">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningParameterSettingSet"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isInputOf"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningTraining"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">initial machine learning parameter setting set</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">machine learning parameter setting set that contains all the values of a machine learning parameter set at the beginning of machine learning training</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/InitializationAlgorithm -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/InitializationAlgorithm">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/Algorithm"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/prescribes"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/EncodedAlgorithm"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isExecutedIn"/>
                                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningParameterInitialization"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">initialization algorithm</rdfs:label>
        <skos:example xml:lang="en-US">Xe initialization used to initialize weights of neurons in an ANN</skos:example>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">algorithm that prescribes how machine learning parameter values will be set at the beginning of machine learning training</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/InstanceBasedAlgorithm -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/InstanceBasedAlgorithm">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningTrainingAlgorithm"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/prescribes"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/EncodedAlgorithm"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isExecutedIn"/>
                                <owl:someValuesFrom>
                                    <owl:Class>
                                        <owl:intersectionOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningTraining"/>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput"/>
                                                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/InstanceBasedModel"/>
                                            </owl:Restriction>
                                        </owl:intersectionOf>
                                    </owl:Class>
                                </owl:someValuesFrom>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">instance-based algorithm</rdfs:label>
        <skos:example xml:lang="en-US">coordinate descent algorithm that creates a support vector machine model</skos:example>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">machine learning algorithm that prescribes how to generate an instance-based model</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/InstanceBasedModel -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/InstanceBasedModel">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/NonParametricModel"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000110"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/FeatureVector"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000177"/>
                                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/TrainingDataSet"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">instance-based model</rdfs:label>
        <skos:example xml:lang="en-US">k-nearest neighbours</skos:example>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">non-parametric model that consists of a subset of feature vectors present in the training dataset that was used to train the model</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/Keras -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/Keras">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningFramework"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">keras</rdfs:label>
        <iof-av:directSource>https://keras.io/</iof-av:directSource>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">machine learning framework that provides an interface for defining, training, and executing machine learning models</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/LinearModel -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/LinearModel">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PolynomialModel"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">linear model</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">polynomial model in which the polynomial function is a linear function</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/LogisticRegression -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/LogisticRegression">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PolynomialModel"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">logistic regression</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">polynomial model that is based on the logistic function and is used to classify inputs into two or more categories</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/LossFunction -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/LossFunction">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MathematicalFunction"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">loss function</rdfs:label>
        <skos:example xml:lang="en-US">Mean absolute error that is used as part of an optimization procedure to measure the absolute difference between the prediction value of the model and the absolute value.</skos:example>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">mathematical function that prescribes how the difference between a target variable and the output of a machine learning model is calculated</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/MachineLearningDataPreparationPipeline -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningDataPreparationPipeline">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/DataProcessingPipeline"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasDataInput"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/RawDataSet"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasDataOutput"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningDataSet"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DataProcessingPipeline"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">machine learning data preparation pipeline</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">planned process that consists of a set of data processing operations and/or data cleaning operations through which a raw dataset is converted into a machine learning dataset</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/MachineLearningDataSet -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningDataSet">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000100"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000110"/>
                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/FeatureVector"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/dataInputOf"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningDataSetPartitioning"/>
                            <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningTraining"/>
                            <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/ModelExecution"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">machine learning data set</rdfs:label>
        <skos:example xml:lang="en-US">dataset that consists of patient PET images used as input into cGAN execution; cNIST dataset used for input in an ANN classification; dataset that consists of values of several CPPs measured over a certain period of time that is used as input for a deep learning model that predicts a particular CQA</skos:example>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">dataset that consists of a number of feature vectors and is intended to be input to machine learning model execution or machine learning training</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/MachineLearningDataSetPartitioning -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningDataSetPartitioning">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasDataInput"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/IAO_0000100"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasDataOutput"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/TrainingDataSet"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasDataOutput"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/TestDataSet"/>
                                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/ValidationDataSet"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">machine learning data set partitioning</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">planned process that splits the input dataset into subsets for machine learning training and model evaluation</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/MachineLearningFramework -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningFramework">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/InformationContentEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000110"/>
                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/EncodedMachineLearningTrainingAlgorithm"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">machine learning framework</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">collection of a number of encoded algorithms necessary for machine learning training, model assessment and model execution encoded in some programming language</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/MachineLearningModel -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningModel">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/EncodedAlgorithm"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000110"/>
                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/ModelExecutionObjective"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">machine learning model</rdfs:label>
        <skos:example xml:lang="en-US">a convolutional neural network, a decision tree</skos:example>
        <iof-av:explanatoryNote xml:lang="en-US">the internal parameters of a machine learning model are determined by some machine learning training</iof-av:explanatoryNote>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">encoded algorithm that is executed to find patterns, make decisions, or make predictions from a previously unseen dataset</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/MachineLearningModelAlgorithm -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningModelAlgorithm">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/Algorithm"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">machine learning model algorithm</rdfs:label>
        <skos:example xml:lang="en-US">the structure of a neural network that is implementation independent</skos:example>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">algorithm that prescribes a machine learning model</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/MachineLearningModelComponent -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningModelComponent">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/InformationContentEntity"/>
                    <owl:Restriction>
                        <owl:onProperty>
                            <rdf:Description>
                                <owl:inverseOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/isComposedOf"/>
                            </rdf:Description>
                        </owl:onProperty>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningModel"/>
                                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningModelAlgorithm"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/InformationContentEntity"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">machine learning model component</rdfs:label>
        <skos:example xml:lang="en-US">support vector within a SVM, neuron within a neural network, cluster within a clustering model</skos:example>
        <iof-av:explanatoryNote xml:lang="en-US">since machine learning model components can either be algorithmic in nature (e.g., neural network layer) or a data item (e.g., a cluster) this class was put directly under ICE</iof-av:explanatoryNote>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">information content entity that is a proper part of a machine learning model or machine learning model algorithm</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/MachineLearningModelDeploymentProcess -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningModelDeploymentProcess">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000057"/>
                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/EngineeredSystem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasInput"/>
                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningModel"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasOutput"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningModel"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000084"/>
                                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/EngineeredSystem"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">machine learning model deployment process</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">planned process in which a machine learning model is deployed in an engineered system</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/MachineLearningModelDevelopmentPipeline -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningModelDevelopmentPipeline">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000117"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningTraining"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000062"/>
                                        <owl:someValuesFrom>
                                            <owl:Class>
                                                <owl:unionOf rdf:parseType="Collection">
                                                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/ExploratoryDataAnalysis"/>
                                                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningDataPreparationPipeline"/>
                                                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningDataSetPartitioning"/>
                                                </owl:unionOf>
                                            </owl:Class>
                                        </owl:someValuesFrom>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000117"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/ModelEvaluation"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000062"/>
                                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningTraining"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000117"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/ExploratoryDataAnalysis"/>
                                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningDataPreparationPipeline"/>
                                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningDataSetPartitioning"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningModel"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">machine learning model development pipeline</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">planned process that consists of a set of processes that are required to develop a machine learning model</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/MachineLearningModelUpdate -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningModelUpdate">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningTraining"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000057"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningModel"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasInput"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningParameterSettingSet"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isOutputOf"/>
                                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningTraining"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningParameterSettingSet"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningTraining"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">machine learning model update</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">planned process in which the machine learning parameters of a previously trained model are updated</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/MachineLearningParameter -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningParameter">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/ConfigurationVariable"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/configurationVariableOf"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningModel"/>
                            <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningModelComponent"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">machine learning parameter</rdfs:label>
        <skos:example xml:lang="en-US">coefficients in a regression model; weights of a neuron</skos:example>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">configuration variable internal to a machine learning model whose value is influenced by (updated on the basis of) input data during machine learning training</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/MachineLearningParameterInitialization -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningParameterInitialization">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/ComputingProcess"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000063"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningTraining"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/executed"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/EncodedInitializationAlgorithm"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasInput"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningParameterSet"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasOutput"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/InitialMachineLearningParameterSettingSet"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/ComputingProcess"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">machine learning parameter initialization</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">computing process that executes an encoded initialization algorithm to create initial machine learning parameter setting set</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/MachineLearningParameterSet -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningParameterSet">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/ConfigurationVariableSet"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">machine learning parameter set</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">collection of machine learning parameters that belong to a particular machine learning model or model component</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/MachineLearningParameterSetting -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningParameterSetting">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/ConfigurationSetting"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isConfigurationSettingOfAtSomeTime"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningParameter"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/ConfigurationSetting"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">machine learning parameter setting</rdfs:label>
        <skos:example xml:lang="en-US">value of a machine learning parameter after machine learning training</skos:example>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">configuration variable setting of a machine learning parameter</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/MachineLearningParameterSettingSet -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningParameterSettingSet">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/ConfigurationVariableSettingSet"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isConfigurationSettingSetOfAtSomeTime"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningParameterSet"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isComposedOf"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningParameterSetting"/>
                            <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningParameterSettingSet"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">machine learning parameter setting set</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">configuration variable setting set that contains all the values of a machine learning parameter set</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/MachineLearningSampleIdentifier -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningSampleIdentifier">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/Identifier"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/designates"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/FeatureVector"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">feature vector identifier</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">identifier that identifies a feature vector within a dataset</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/MachineLearningTraining -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningTraining">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/ComputingProcess"/>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <owl:Class>
                                        <owl:intersectionOf rdf:parseType="Collection">
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasInput"/>
                                                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/InitialMachineLearningParameterSettingSet"/>
                                            </owl:Restriction>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasOutput"/>
                                                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningParameterSettingSet"/>
                                            </owl:Restriction>
                                        </owl:intersectionOf>
                                    </owl:Class>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000057"/>
                                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningModel"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput"/>
                                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningModel"/>
                            </owl:Restriction>
                        </owl:unionOf>
                    </owl:Class>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/executed"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/EncodedMachineLearningTrainingAlgorithm"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasDataInput"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/TrainingDataSet"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/ComputingProcess"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">machine learning training</rdfs:label>
        <iof-av:explanatoryNote xml:lang="en-US">Learning is defined in this case as progressively improving performance of the underlying model on a predefined task.</iof-av:explanatoryNote>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">computing process in which an encoded machine learning algorithm is executed to generate or update a machine learning model</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/MachineLearningTrainingAlgorithm -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningTrainingAlgorithm">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/Algorithm"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/prescribes"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/EncodedAlgorithm"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isExecutedIn"/>
                                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningTraining"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">machine learning training algorithm</rdfs:label>
        <skos:example xml:lang="en-US">backpropagation algorithm used to train a neural network; M5 algorithm used to generate a decision tree model</skos:example>
        <iof-av:explanatoryNote xml:lang="en-US">machine learning training algorithms determine how the patterns and rules from the input machine learning dataset will be stored in and used to create or update a machine learning model</iof-av:explanatoryNote>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">algorithm that prescribes how a machine learning model will be updated or generated</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/MathematicalFunction -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/MathematicalFunction">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/InformationContentEntity"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">mathematical function</rdfs:label>
        <skos:example xml:lang="en-US">y=x+2, any polynomial, y=sin(x)</skos:example>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">an expression, rule, or law that defines a relationship between one or more variables (the independent variables) and another set of variables (the dependent variables)</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/MeanAbsoluteError -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/MeanAbsoluteError">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PerformanceMetric"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">mean absolute error</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">performance metric which prescribes how to determine the average of the absolute differences between predicted values and observed values</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/MeasuredValueExpression -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/MeasuredValueExpression">
        <owl:disjointWith rdf:resource="https://spec.industrialontologies.org/ontology/construct/SimulatedValueExpression"/>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/ModelAssumptions -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/ModelAssumptions">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/ModelInputRequirementSpecification"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">model assumptions</rdfs:label>
        <iof-av:explanatoryNote xml:lang="en-US">These conditions are typically checkable.</iof-av:explanatoryNote>
        <iof-av:explanatoryNote xml:lang="en-US">to be a valid input in this context means that it is an input of a computing process which executes an encoding of the model or algorithm</iof-av:explanatoryNote>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">model input requirement specification that specifies the data item characteristics that features, feature vectors, or feature vector sets must have</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/ModelCharacteristic -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/ModelCharacteristic">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/informationContentEntityCharacteristicOf"/>
                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningModel"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/EncodedAlgorithmCharacteristic"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">model characteristic</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">encoded algorithm characteristic of a machine learning model</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/ModelEvaluation -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/ModelEvaluation">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/ModelPerformanceAssessment"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasDataInput"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/ModelOutputDataSet"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/informationContentEntityDerivedFrom"/>
                                        <owl:someValuesFrom>
                                            <owl:Class>
                                                <owl:unionOf rdf:parseType="Collection">
                                                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/TestDataSet"/>
                                                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/ValidationDataSet"/>
                                                </owl:unionOf>
                                            </owl:Class>
                                        </owl:someValuesFrom>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/ModelPerformanceAssessment"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">model evaluation</rdfs:label>
        <iof-av:explanatoryNote xml:lang="en-US">an independent dataset means that the dataset has not been used for model training</iof-av:explanatoryNote>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">model performance assessment that evaluates the quality of a model output that was derived from an independent dataset</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/ModelExecution -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/ModelExecution">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/ComputingProcess"/>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasDataInput"/>
                                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/FeatureVector"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasDataOutput"/>
                                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/ModelOutput"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasDataInput"/>
                                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningDataSet"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasDataOutput"/>
                                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/ModelOutputDataSet"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:unionOf>
                    </owl:Class>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000059"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningParameterSettingSet"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/executed"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningModel"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/ComputingProcess"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">model execution</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">planned process in which some machine learning model is executed on a machine learning dataset or on a feature vector</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/ModelExecutionObjective -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/ModelExecutionObjective">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/ObjectiveSpecification"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isAchievedByAtSomeTime"/>
                <owl:allValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/ModelExecution"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">model execution objective</rdfs:label>
        <skos:example xml:lang="en-US">predicting a patient therapy dose based on pre-therapy images, predicting a CQA based parameter inputs, detecting common patterns of gene expression within a pancreatic cancer patient cohort</skos:example>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">objective specification that prescribes what the outcome of a model execution should be</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/ModelInputRequirementSpecification -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/ModelInputRequirementSpecification">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/RequirementSpecification"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">model input requirements</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">requirement specification that specifies the conditions to which an input to machine learning training or execution must conform to for a particular machine learning model</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/ModelOutput -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/ModelOutput">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000027"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/dataOutputOf"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/ModelExecution"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/informationContentEntityDerivedFrom"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/FeatureVector"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">model output</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">data item that is created as an output of a model execution that corresponds to a single feature vector</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/ModelOutputDataSet -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/ModelOutputDataSet">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000100"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/dataOutputOf"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/ModelExecution"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isComposedOf"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/ModelOutput"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000100"/>
        <owl:disjointWith rdf:resource="https://spec.industrialontologies.org/ontology/construct/PreProcessedDataSet"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">model output data set</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">dataset that consists of model outputs</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/ModelOutputTransformationAlgorithm -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/ModelOutputTransformationAlgorithm">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/Algorithm"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">model output transformation algorithm</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">algorithm that prescribes how to transform model output data into a specific representation</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/ModelOutputTransformationOperation -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/ModelOutputTransformationOperation">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/DataProcessingOperation"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/executed"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/EncodedAlgorithm"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/prescribedBy"/>
                                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/ModelOutputTransformationAlgorithm"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasInput"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/ModelOutput"/>
                                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/ModelOutputDataSet"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DataProcessingOperation"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">model output transformation operation</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">data processing operation which transforms the model output to a particular representation</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/ModelPerformanceAssessment -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/ModelPerformanceAssessment">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000059"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/PerformanceMetric"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasDataInput"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/ModelOutputDataSet"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/ModelPerformanceResult"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">model performance assessment</rdfs:label>
        <skos:example xml:lang="en-US">estimating the performance of a CNN on an image classification task</skos:example>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">planned process in which the quality of a model output is assessed with respect to some performance metric</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/ModelPerformanceMonitoring -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/ModelPerformanceMonitoring">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000132"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/DeployedMachineLearningModelState"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/occursSimultaneouslyWith"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/DeployedMachineLearningModelState"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/temporallyFinishes"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/DeployedMachineLearningModelState"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/temporallyStarts"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/DeployedMachineLearningModelState"/>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000117"/>
                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/ModelPerformanceAssessment"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">model performance monitoring</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">planned process during which model performance of a deployed model is assessed</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/ModelPerformanceResult -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/ModelPerformanceResult">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/InformationContentEntity"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/describes"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningModel"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isAbout"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/ModelOutputDataSet"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isSpecifiedOutputOf"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/ModelPerformanceAssessment"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/InformationContentEntity"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">model performance result</rdfs:label>
        <skos:example xml:lang="en-US">the result of determining the mean absolute error between predictions and the target variable on a particular dataset</skos:example>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">information content entity that is the result of assessing the performance of a machine learning model with a particular dataset</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/ModelSelection -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/ModelSelection">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000117"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/ModelEvaluation"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasInput"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/GroupOfMachineLearningModels"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningModel"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">model selection</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">planned process in which model that has the best performance is selected among a number of machine learning models</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/ModelValidation -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/ModelValidation">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000117"/>
                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/ModelEvaluation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000117"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningDataSetPartitioning"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000063"/>
                                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningTraining"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000117"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningTraining"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000063"/>
                                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/ModelEvaluation"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">model validation</rdfs:label>
        <skos:example xml:lang="en-US">Leave one out cross validation</skos:example>
        <iof-av:explanatoryNote xml:lang="en-US">iterations are typically performed until each feature vector is used for model evaluation</iof-av:explanatoryNote>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">planned process in which a machine learning model is evaluated through successive iterations of dataset partitioning, machine learning training and model evaluation</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/MultiLayerPerceptron -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/MultiLayerPerceptron">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/ArtificialNeuralNetwork"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isComposedOf"/>
                <owl:allValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/FullyConnectedLayer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">multi layer perceptron</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">artificial neural network composed of only fully connected layers</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/NeuralNetworkLayer -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/NeuralNetworkLayer">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningModelComponent"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000137"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/ArtificialNeuralNetwork"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isComposedOf"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/Neuron"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">neural network layer</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">machine learning model component that consists of neurons operating together at a specific depth within a neural network</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/NeuralNetworkLayerBias -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/NeuralNetworkLayerBias">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/NeuralNetworkParameter"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/configurationVariableOf"/>
                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/NeuralNetworkLayer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">neural network layer bias</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">neural network parameter of a neural network layer that is added to the product of the layer input and neural network layer weights</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/NeuralNetworkParameter -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/NeuralNetworkParameter">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningParameter"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/configurationVariableOf"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/ArtificialNeuralNetwork"/>
                                    <owl:Class>
                                        <owl:intersectionOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningModelComponent"/>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000137"/>
                                                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/ArtificialNeuralNetwork"/>
                                            </owl:Restriction>
                                        </owl:intersectionOf>
                                    </owl:Class>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">neural network parameter</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">machine learning parameter of a neural network model or its component</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/Neuron -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/Neuron">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningModelComponent"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">neuron</rdfs:label>
        <iof-av:explanatoryNote xml:lang="en-US">input in the definition is here serving as a shorthand for the execution of a neuron and the input to the &quot;part of the process&quot; during which the execution of the neuron occurs</iof-av:explanatoryNote>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">machine learning model component that is a part of a neural network layer and that has a set of scalar values which modify the input through multiplication</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/NeuronWeight -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/NeuronWeight">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/NeuralNetworkParameter"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/configurationVariableOf"/>
                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/Neuron"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">neuron weight</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">neural network parameter of a neuron</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/Noise -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/Noise">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/InformationContentEntity"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">noise</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">random or unpredictable fluctuations in data that disrupt the ability to identify target patterns or relationships</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/NominalClassificationScheme -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/NominalClassificationScheme">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/ClassificationScheme"/>
        <dcterms:description>classification scheme that prescribes values which do not have any implicit ordering relation between them</dcterms:description>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">nominal classification scheme</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">classification scheme whose categories do not have an intrinsic order</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/NominalFeature -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/NominalFeature">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/CategoricalFeature"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/prescribedBy"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/NominalClassificationScheme"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/CategoricalFeature"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">nominal feature</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">categorical feature whose possible values have no implicit ordering</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/NonParametricModel -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/NonParametricModel">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningModel"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">non-parametric model</rdfs:label>
        <iof-av:adaptedFrom>https://www.kaggle.com/discussions/general/324532</iof-av:adaptedFrom>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">machine learning model that does not have a fixed pre-determined number of parameters</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/NumericalFeature -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/NumericalFeature">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/Feature"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">numerical feature</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">feature that has quantitative numeric values</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/ObjectiveSpecification -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/ObjectiveSpecification"/>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/OneHotEncoding -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/OneHotEncoding">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DataProcessingOperation"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/FeatureEngineeringTransformation"/>
                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/ModelOutputTransformationOperation"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">one hot encoding</rdfs:label>
        <iof-av:explanatoryNote xml:lang="en-US">the length of the vector depends on the number of categorical variables specified in the classification scheme</iof-av:explanatoryNote>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">feature engineering transformation or model output transformation operation where a categorical input is transformed into a vector of binary values</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/OptimizationAlgorithm -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/OptimizationAlgorithm">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/Algorithm"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">optimization algorithm</rdfs:label>
        <skos:example xml:lang="en-US">adam optimizer, stochastic gradient descent</skos:example>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">algorithm that prescribes how to find the minimum or maximum of an objective function</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/OrdinalClassificationScheme -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/OrdinalClassificationScheme">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/ClassificationScheme"/>
        <dcterms:description>classification scheme that prescribes values which have an implicit ordering relation between them</dcterms:description>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">ordinal classification scheme</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">classification scheme whose categories have an intrinsic order</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/OrdinalFeature -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/OrdinalFeature">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/CategoricalFeature"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/prescribedBy"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/OrdinalClassificationScheme"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/CategoricalFeature"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">ordinal feature</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">categorical feature whose possible values have an implicit ordering</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/PerformanceMetric -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/PerformanceMetric">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MathematicalFunction"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">performance metric</rdfs:label>
        <skos:example xml:lang="en-US">classification accuracy used to estimate the performance of a CNN on image classification task</skos:example>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">function that prescribes how to assess the performance of a machine learning model</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/PlanSpecification -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/PlanSpecification"/>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/PlannedProcess -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/PoissonNoise -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/PoissonNoise">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/Noise"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">poisson noise</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">noise whose values follow a poisson distribution</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/PolynomialFeature -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/PolynomialFeature">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DerivedFeature"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/informationContentEntityDerivedFrom"/>
                <owl:allValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/NumericalFeature"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">polynomial feature</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">derived feature that was created by raising a numerical feature by some exponent</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/PolynomialFunction -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/PolynomialFunction">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MathematicalFunction"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">polynomial function</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">mathematical function that consists of coefficients, variables, constants, operators, and non-negative integers as exponents</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/PolynomialModel -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/PolynomialModel">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningModel"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000110"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/RegressionObjective"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasComplexValueExpressionAtAllTimes"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/PolynomialFunction"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningModel"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">polynomial model</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">machine learning model that is an explicitly parameterized polynomial function</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/PolynomialModelTrainingAlgorithm -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/PolynomialModelTrainingAlgorithm">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningTrainingAlgorithm"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/prescribes"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/EncodedAlgorithm"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isExecutedIn"/>
                                <owl:someValuesFrom>
                                    <owl:Class>
                                        <owl:intersectionOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningTraining"/>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000057"/>
                                                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/PolynomialModel"/>
                                            </owl:Restriction>
                                        </owl:intersectionOf>
                                    </owl:Class>
                                </owl:someValuesFrom>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">polynomial model training algorithm</rdfs:label>
        <skos:example xml:lang="en-US">ordinary least squares</skos:example>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">machine learning algorithm that prescribes the training of a regression model</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/PoolingLayer -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/PoolingLayer">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/NeuralNetworkLayer"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">pooling layer</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">neural network layer that reduces the spatial dimensions of input data by applying a downsampling operation</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/PreProcessedDataSet -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/PreProcessedDataSet">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000100"/>
        <owl:disjointWith rdf:resource="https://spec.industrialontologies.org/ontology/construct/RawDataSet"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">preprocessed data set</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">dataset that is the result of a data cleaning pipeline</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/PredictionObjective -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/PredictionObjective">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/ModelExecutionObjective"/>
        <owl:disjointUnionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/ClassificationObjective"/>
            <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/RegressionObjective"/>
        </owl:disjointUnionOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">prediction objective</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">model execution objective to predict some classification or a numeric value of an entity</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/ProductionMachineLearningDataSet -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/ProductionMachineLearningDataSet">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningDataSet"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/dataInputOf"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/ModelExecution"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/executed"/>
                                <owl:someValuesFrom>
                                    <owl:Class>
                                        <owl:intersectionOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningModel"/>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000166"/>
                                                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/DeployedMachineLearningModelState"/>
                                            </owl:Restriction>
                                        </owl:intersectionOf>
                                    </owl:Class>
                                </owl:someValuesFrom>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">production machine learning data set</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">machine learning dataset that is used as input to the execution of a deployed model</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/RSquared -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/RSquared">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PerformanceMetric"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">r squared</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">performance metric utilized for regression model assessment which prescribes how to determine the portion of variance in the observed values that is predictable by the model</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/RawDataSet -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/RawDataSet">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000100"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">raw data set</rdfs:label>
        <skos:example xml:lang="en-US">dataset that consists of unprocessed outputs from a series of measurement processes</skos:example>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">dataset collected from a domain of interest, that has not undergone any data processing</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/RectifiedLinearUnit -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/RectifiedLinearUnit">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/ActivationFunction"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">rectified linear unit</rdfs:label>
        <iof-av:abbreviation>ReLU</iof-av:abbreviation>
        <iof-av:adaptedFrom>https://www.kaggle.com/code/dansbecker/rectified-linear-units-relu-in-deep-learning</iof-av:adaptedFrom>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">activation function that sets all negative output values to 0 and does not modify non-negative output values</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/RegressionCoefficient -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/RegressionCoefficient">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/RegressionParameter"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">regression coefficient</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">regression parameter that has a scalar value which modifies a particular input feature by multiplying it</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/RegressionIntercept -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/RegressionIntercept">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/RegressionParameter"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">regression intercept</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">regression parameter whose value is the mean of the target variables used to train the regression model and that is added to the output of regression model execution</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/RegressionObjective -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/RegressionObjective">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PredictionObjective"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">regression objective</rdfs:label>
        <skos:example xml:lang="en-US">A GAN model has the objective to predict the post-therapy dose value in each voxel based on the pre-therapy scans of a patient</skos:example>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">prediction objective to output a numeric prediction of an attribute of an entity</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/RegressionParameter -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/RegressionParameter">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningParameter"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/configurationVariableOf"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/PolynomialModel"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningParameter"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">regression parameter</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">machine learning parameter of a regression model</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/RegularizationMethod -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/RegularizationMethod">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/Algorithm"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">regularization method</rdfs:label>
        <skos:example xml:lang="en-US">L1 regularization, L2 regularization, dropout regularization</skos:example>
        <iof-av:explanatoryNote xml:lang="en-US">Regularization is typically introduced to avoid model overfitting</iof-av:explanatoryNote>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">algorithm that prescribes how to constrain the set of possible machine learning parameter values during machine learning training</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/ReinforcementLearning -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/ReinforcementLearning">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningTraining"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningModel"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000110"/>
                                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/ActionSelectionObjective"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">reinforcement learning</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">machine learning training used for learning an action selection model and that is based on a feedback interaction with an environment</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/RequirementSpecification -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/RequirementSpecification"/>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/RootMeanSquaredError -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/RootMeanSquaredError">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PerformanceMetric"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">root mean squared error</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">performance metric which prescribes how to determine the root of the average of the squared differences between predicted values and observed values</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/ScaledFeature -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/ScaledFeature">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/DerivedFeature"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/dataOutputOf"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/FeatureScalingOperation"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">scaled feature</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">derived feature that is a result of a feature scaling operation</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/SemiSupervisedLearning -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/SemiSupervisedLearning">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningTraining"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasDataInput"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/TargetVariableVector"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasDataInput"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningDataSet"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isComposedOf"/>
                                        <owl:someValuesFrom>
                                            <owl:Class>
                                                <owl:intersectionOf rdf:parseType="Collection">
                                                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/FeatureVector"/>
                                                    <owl:Class>
                                                        <owl:complementOf>
                                                            <owl:Restriction>
                                                                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasTargetVariable"/>
                                                                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/TargetVariable"/>
                                                            </owl:Restriction>
                                                        </owl:complementOf>
                                                    </owl:Class>
                                                </owl:intersectionOf>
                                            </owl:Class>
                                        </owl:someValuesFrom>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isComposedOf"/>
                                        <owl:someValuesFrom>
                                            <owl:Class>
                                                <owl:intersectionOf rdf:parseType="Collection">
                                                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/FeatureVector"/>
                                                    <owl:Restriction>
                                                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasTargetVariable"/>
                                                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/TargetVariable"/>
                                                    </owl:Restriction>
                                                </owl:intersectionOf>
                                            </owl:Class>
                                        </owl:someValuesFrom>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningTraining"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">semi supervised learning</rdfs:label>
        <iof-av:explanatoryNote xml:lang="en-US">semi supervised learning is typically used when only a subset of the training samples have a target variable available.</iof-av:explanatoryNote>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">machine learning training procedure based on a combination of supervised and unsupervised learning</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/SequentialFeature -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/SequentialFeature">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/Feature"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isComposedOf"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/prescribedBy"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/SequentialFeatureOrderingScheme"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">sequential feature</rdfs:label>
        <skos:example xml:lang="en-US">time series, textual features</skos:example>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">feature that consists of data items that have an explicit ordering along one dimension</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/SequentialFeatureOrderingScheme -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/SequentialFeatureOrderingScheme">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/InformationContentEntityOrderingScheme"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/informationContentEntityDerivedFrom"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000027"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000100"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isAbout"/>
                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/SequentialFeature"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">sequential feature ordering scheme</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">information content entity ordering scheme that dictates the ordering of a sequential feature</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/SimulatedValueExpression -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/SimulatedValueExpression">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/ValueExpression"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">simulated value expression</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">value expression that was generated by a predictive model</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/Softmax -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/Softmax">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/ActivationFunction"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">softmax</rdfs:label>
        <iof-av:adaptedFrom>https://en.wikipedia.org/wiki/Softmax_function</iof-av:adaptedFrom>
        <iof-av:explanatoryNote xml:lang="en-US">the exponential function has been applied to all output values prior to the sum</iof-av:explanatoryNote>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">activation function that transforms all output values to probability values by applying a standard exponential function to each individual output value and then normalizing each value by dividing it by the sum of all the exponentials</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/SpecifiedValueExpression -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/SpecifiedValueExpression">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/ValueExpression"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000177"/>
                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/DirectiveInformationContentEntity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">specified value expression</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">value expression that is part of a specification and that prescribes the value that the attribute should have</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/StatisticalSignificanceCriteria -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/StatisticalSignificanceCriteria">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/RequirementSpecification"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">statistical significance criteria</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">requirement specification that prescribes the range of values that the result of a statistical hypothesis test should have to be statistically significant</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/StatisticallySignificantParameter -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/StatisticallySignificantParameter">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningParameter"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/satisfiesRequirement"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/StatisticalSignificanceCriteria"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningParameter"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">statistically significant parameter</rdfs:label>
        <skos:example xml:lang="en-US">a regression coefficient that has a p value less than the required significance level</skos:example>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">machine learning parameter that has been estimated as statistically significant by some statistical significance criteria</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/SuccessRate -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/SuccessRate">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PerformanceMetric"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">success rate</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">performance metric that prescribes how to assess the percentage of correctly predicted output values within some specified margin of error</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/SupervisedLearning -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/SupervisedLearning">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningTraining"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasDataInput"/>
                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/TargetVariableVector"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://spec.industrialontologies.org/ontology/construct/UnsupervisedLearning"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">supervised learning</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">machine learning training based on comparing the model outputs to known target variables, which are available for each sample in the training set</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/SupportVectorMachine -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/SupportVectorMachine">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/InstanceBasedModel"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">support vector machine</rdfs:label>
        <iof-av:adaptedFrom>https://www.iso.org/obp/ui/#iso:std:iso-iec:22989:ed-1:v1:en:term:3.3.13</iof-av:adaptedFrom>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">instance-based model that consists of a hyperplane (decision boundary) with maximal margins from the selected group of feature vectors (support vectors)</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/TargetVariable -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/TargetVariable">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000027"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/targetVariableOf"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/FeatureVector"/>
                    </owl:Restriction>
                </owl:intersectionOf>
