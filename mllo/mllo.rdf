        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">textual feature</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">feature that consists of a sequence of words whose order conveys a meaning</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/TimeSeries -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/TimeSeries">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/SequentialFeature"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isSubjectOf"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/SequentialFeatureOrderingScheme"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/informationContentEntityDerivedFrom"/>
                                        <owl:someValuesFrom>
                                            <owl:Class>
                                                <owl:intersectionOf rdf:parseType="Collection">
                                                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000100"/>
                                                    <owl:Restriction>
                                                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isComposedOf"/>
                                                        <owl:someValuesFrom>
                                                            <owl:Restriction>
                                                                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isValueExpressionOfAtSomeTime"/>
                                                                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000008"/>
                                                            </owl:Restriction>
                                                        </owl:someValuesFrom>
                                                    </owl:Restriction>
                                                </owl:intersectionOf>
                                            </owl:Class>
                                        </owl:someValuesFrom>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/SequentialFeature"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">time series</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">feature that consists of a sequence of observations taken sequentially in time</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/TrainingDataSet -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/TrainingDataSet">
