    </owl:ObjectProperty>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/isTheIndexOf -->

    <owl:ObjectProperty rdf:about="https://spec.industrialontologies.org/ontology/construct/isTheIndexOf">
