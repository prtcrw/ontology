        <rdfs:label xml:lang="en-US">encoded initialization algorithm</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">encoded algorithm that is the implementation of an initialization algorithm</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/EncodedMachineLearningTrainingAlgorithm -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/EncodedMachineLearningTrainingAlgorithm">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/EncodedAlgorithm"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/prescribedBy"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningTrainingAlgorithm"/>
                    </owl:Restriction>
