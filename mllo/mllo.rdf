        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/EncodedAlgorithm"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">encoded optimization algorithm</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">encoded algorithm that is the implementation of an optimization algorithm</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/EncodedRegularizationMethod -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/EncodedRegularizationMethod">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/EncodedAlgorithm"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/prescribedBy"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/RegularizationMethod"/>
                    </owl:Restriction>
