    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/EncodedFeatureEngineeringAlgorithm">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
