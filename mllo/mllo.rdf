        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">has configuration setting value</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">data property that has as value the literal value specified by a configuration setting</iof-av:naturalLanguageDefinition>
    </owl:DatatypeProperty>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/hasDataTypeValue -->

    <owl:DatatypeProperty rdf:about="https://spec.industrialontologies.org/ontology/construct/hasDataTypeValue">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">has data type value</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">data property that has as value a data type specification</iof-av:naturalLanguageDefinition>
    </owl:DatatypeProperty>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/hasDimensionNumberValue -->

    <owl:DatatypeProperty rdf:about="https://spec.industrialontologies.org/ontology/construct/hasDimensionNumberValue">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">has dimension number value</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">data property that has as value the number of dimensions of an information content entity</iof-av:naturalLanguageDefinition>
    </owl:DatatypeProperty>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/hasDimensionShapeValue -->

    <owl:DatatypeProperty rdf:about="https://spec.industrialontologies.org/ontology/construct/hasDimensionShapeValue">
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">has dimension shape value</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">data property that has as value the shape of one or more dimensions of an information content entity</iof-av:naturalLanguageDefinition>
    </owl:DatatypeProperty>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/hasExponent -->

    <owl:DatatypeProperty rdf:about="https://spec.industrialontologies.org/ontology/construct/hasExponent">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">has exponent</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">data property that has as value the exponent used in a mathematical expression</iof-av:naturalLanguageDefinition>
    </owl:DatatypeProperty>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/hasFormula -->

    <owl:DatatypeProperty rdf:about="https://spec.industrialontologies.org/ontology/construct/hasFormula">
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
