        <iof-av:naturalLanguageDefinition xml:lang="en-US">data property that has as value a textual representation of a formula</iof-av:naturalLanguageDefinition>
    </owl:DatatypeProperty>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/hasIndexValue -->

    <owl:DatatypeProperty rdf:about="https://spec.industrialontologies.org/ontology/construct/hasIndexValue">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://spec.industrialontologies.org/ontology/construct/Index"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">has index value</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">data property that has as value the literal value of an index</iof-av:naturalLanguageDefinition>
    </owl:DatatypeProperty>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/hasMathematicalFormulaValue -->

    <owl:DatatypeProperty rdf:about="https://spec.industrialontologies.org/ontology/construct/hasMathematicalFormulaValue">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">has mathematical formula value</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">data property that has as value a mathematical formula</iof-av:naturalLanguageDefinition>
    </owl:DatatypeProperty>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/hasStandardDeviationValue -->

    <owl:DatatypeProperty rdf:about="https://spec.industrialontologies.org/ontology/construct/hasStandardDeviationValue">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">has standard deviation value</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">data property that has as value a standard deviation</iof-av:naturalLanguageDefinition>
    </owl:DatatypeProperty>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/hasTextValue -->

    <owl:DatatypeProperty rdf:about="https://spec.industrialontologies.org/ontology/construct/hasTextValue">
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">has text value</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">data property that has as value a text string</iof-av:naturalLanguageDefinition>
    </owl:DatatypeProperty>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/hasVersion -->

    <owl:DatatypeProperty rdf:about="https://spec.industrialontologies.org/ontology/construct/hasVersion">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://spec.industrialontologies.org/ontology/construct/InformationContentEntity"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">has version</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">data property that has as value a version identifier</iof-av:naturalLanguageDefinition>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.obolibrary.org/obo/IAO_0000025 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000025">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/InformationContentEntity"/>
        <rdfs:label xml:lang="en-US">programming language</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">A language in which source code is written, intended to executed/run by a software interpreter. Programming languages are ways to write instructions that specify what to do, and sometimes, how to do it.</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000027 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000027">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/InformationContentEntity"/>
        <rdfs:label xml:lang="en-US">data item</rdfs:label>
        <skos:example xml:lang="en-US">Data items include counts of things, analyte concentrations, and statistical summaries.</skos:example>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">An information content entity that is intended to be a truthful statement about something (modulo, e.g., measurement precision or other systematic errors) and is constructed/acquired by a method which reliably tends to produce (approximately) truthful statements.</iof-av:naturalLanguageDefinition>
        <iof-av:synonym xml:lang="en">data</iof-av:synonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000098 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000098">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/InformationContentEntity"/>
        <rdfs:label xml:lang="en-US">data format specification</rdfs:label>
        <iof-av:directSource xml:lang="en">OBI_0000187</iof-av:directSource>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">A data format specification is the information content borne by the document published defining the specification.
Example: The ISO document specifying what encompasses an XML document; The instructions in a XSD file</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000100 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000100">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/InformationContentEntity"/>
        <rdfs:label xml:lang="en-US">data set</rdfs:label>
        <skos:example xml:lang="en-US">Intensity values in a CEL file or from multiple CEL files comprise a dataset (as opposed to the CEL files themselves).</skos:example>
        <iof-av:directSource xml:lang="en">OBI_0000042</iof-av:directSource>
        <iof-av:explanatoryNote xml:lang="en-US">1.The intention is that this term represent collections of like data. So this isn&apos;t for, e.g. the whole contents of a cel file, which includes parameters, metadata etc. This is more like java arrays of a certain rather specific type
2. Data sets are aggregates and thus must include two or more data items. We have chosen not to add logical axioms to make this restriction.</iof-av:explanatoryNote>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">Information content entity that is an aggregate of data items of the same type that have something in common. Averages and distributions can be determined for datasets.</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/STATO_0000225 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/STATO_0000225">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/InformationContentEntity"/>
        <rdfs:label xml:lang="en-US">probability distribution</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">A probability distribution is an information content entity that specifies the probability of the value of a random variable.

For a discrete random variable, a mathematical formula that gives the probability of each value of the variable.

For a continuous random variable, a curve described by a mathematical formula which specifies, by way of areas under the curve, the probability that the variable falls within a particular interval.</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/STATO_0000531 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/STATO_0000531">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/STATO_0000225"/>
        <rdfs:label xml:lang="en-US">prior probability distribution</rdfs:label>
        <iof-av:adaptedFrom>Oxford Dictionary of Statistics: 10.1093/acref/9780199541454.001.0001</iof-av:adaptedFrom>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">a prior probability distribution is a probability distribution used as input to a Bayesian model to represent a priori knowledge about a model parameter. Along with the acquired/observed data, it is used to compute a posterior distribution according to the Bayes theorem.</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/ActionSelectionObjective -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/ActionSelectionObjective">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/ModelExecutionObjective"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">action selection objective</rdfs:label>
        <skos:example xml:lang="en-US">an RNN is used for selecting the next control action in a bioreactor co-culture growth based on the state of the environment (e.g. nutrient availability, population of each cell type)</skos:example>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">model execution objective to output an optimal action within a given environment</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/ActionSpecification -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/ActionSpecification"/>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/ActivationFunction -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/ActivationFunction">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MathematicalFunction"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">activation function</rdfs:label>
        <iof-av:explanatoryNote xml:lang="en-US">an activation function is typically a non-linear transformation of the output of the neural network layer</iof-av:explanatoryNote>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">function that prescribes how an output of a neural network layer is modified</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/AdamOptimizer -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/AdamOptimizer">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/OptimizationAlgorithm"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">adam optimizer</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">optimization algorithm that prescribes how to find a minimum or a maximum by adaptive moment estimation</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/Algorithm -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/Algorithm"/>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/AlgorithmCharacteristic -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/AlgorithmCharacteristic">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/informationContentEntityCharacteristicOf"/>
                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/Algorithm"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/InformationContentEntityCharacteristic"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">algorithm characteristic</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">information content entity characteristic of an algorithm</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/AlgorithmVerbosity -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/AlgorithmVerbosity">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/ConfigurationVariable"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">algorithm verbosity</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">algorithm characteristic that specifies the amount of runtime information an encoded algorithm reports during execution</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/ArtificialNeuralNetwork -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/ArtificialNeuralNetwork">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningModel"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isComposedOf"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/NeuralNetworkLayer"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningModel"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">artificial neural network</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">machine learning model which consists of a collection of connected units or nodes called artificial neurons, which loosely model the neurons in a biological brain</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/ArtificialNeuralNetworkTrainingAlgorithm -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/ArtificialNeuralNetworkTrainingAlgorithm">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningTrainingAlgorithm"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/prescribes"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/EncodedAlgorithm"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isExecutedIn"/>
                                <owl:someValuesFrom>
                                    <owl:Class>
                                        <owl:intersectionOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningTraining"/>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000057"/>
                                                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/ArtificialNeuralNetwork"/>
                                            </owl:Restriction>
                                        </owl:intersectionOf>
                                    </owl:Class>
                                </owl:someValuesFrom>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">artificial neural network training algorithm</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">machine learning algorithm that prescribes the training of an artificial neural network</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/AssociationRuleLearningAlgorithm -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/AssociationRuleLearningAlgorithm">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningTrainingAlgorithm"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/prescribes"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/EncodedAlgorithm"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isExecutedIn"/>
                                <owl:someValuesFrom>
                                    <owl:Class>
                                        <owl:intersectionOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningTraining"/>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000057"/>
                                                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/AssociationRuleModel"/>
                                            </owl:Restriction>
                                        </owl:intersectionOf>
                                    </owl:Class>
                                </owl:someValuesFrom>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">association rule learning algorithm</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">machine learning algorithm that prescribes how an association rule model is trained</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/AssociationRuleModel -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/AssociationRuleModel">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningModel"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">association rule model</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">machine learning model that finds the relations between features and determines the reliability of those associations</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/AveragePoolingLayer -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/AveragePoolingLayer">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PoolingLayer"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">average pooling layer</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">pooling layer that reduces input data dimensions by computing the average value of elements within a defined region</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/Backpropagation -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/Backpropagation">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/ArtificialNeuralNetworkTrainingAlgorithm"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">backpropagation</rdfs:label>
        <iof-av:explanatoryNote xml:lang="en-US">the gradients are calculated during an optimization process</iof-av:explanatoryNote>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">artificial neural network training algorithm that prescribes how the weights of neurons should be updated based on their gradients</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/BatchSize -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/BatchSize">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/Hyperparameter"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">batch size</rdfs:label>
        <iof-av:directSource>https://medium.com/geekculture/how-does-batch-size-impact-your-model-learning-2dd34d9fb1fa</iof-av:directSource>
        <iof-av:explanatoryNote xml:lang="en-US">sample in the case of supervised learning consists of the input feature vector as well as the target variable</iof-av:explanatoryNote>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">parameter that defines the number of samples to work through before updating the internal model parameters</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/BayesianAlgorithm -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/BayesianAlgorithm">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningTrainingAlgorithm"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">bayesian algorithm</rdfs:label>
        <skos:example xml:lang="en-US">training a neural network with a prior probability distribution for neural network weights; utilization of prior distribution for loss regularization</skos:example>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">machine learning algorithm that prescribes how bayesian statistics is used in training a machine learning model</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/CategoricalFeature -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/CategoricalFeature">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/Feature"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/prescribedBy"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/ClassificationScheme"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/Feature"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">categorical feature</rdfs:label>
        <skos:example xml:lang="en-US">&quot;low risk&quot; value of a process parameter that is prescribed by a risk analysis classification scheme</skos:example>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">feature that can have only a limited, and usually fixed, number of possible values prescribed by some classification scheme</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/ClassificationAccuracy -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/ClassificationAccuracy">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PerformanceMetric"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">classification accuracy</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">performance metric that prescribes how to assess the percentage of correctly classified inputs</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/ClassificationObjective -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/ClassificationObjective">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PredictionObjective"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">classification objective</rdfs:label>
        <skos:example xml:lang="en-US">A CNN model has the objective to classify the input images into categories that represent if the object on the picture is an animal or not</skos:example>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">prediction objective to categorize the input</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/ClassificationScheme -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/ClassificationScheme">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/InformationContentEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/prescribes"/>
                <owl:allValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/ValueExpression"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">classification scheme</rdfs:label>
        <skos:example xml:lang="en-US">binary classification scheme of &quot;true&quot; &quot;false&quot; that has no implicit ordering meaning, the classification scheme of &quot;low&quot; &quot;medium&quot; &quot;high&quot; that has explicit ordering whereby &quot;low&quot;&lt;&quot;medium&quot;&lt;&quot;high&quot;</skos:example>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">information content entity that prescribes the values that a categorical value expression can have</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/Cluster -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/Cluster">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningModelComponent"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">cluster</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">machine learning model component that consists of a number of samples used in model input that are grouped together</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/ClusteringAlgorithm -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/ClusteringAlgorithm">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningTrainingAlgorithm"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/prescribes"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/EncodedAlgorithm"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isExecutedIn"/>
                                <owl:someValuesFrom>
                                    <owl:Class>
                                        <owl:intersectionOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningTraining"/>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput"/>
                                                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/ClusteringModel"/>
                                            </owl:Restriction>
                                        </owl:intersectionOf>
                                    </owl:Class>
                                </owl:someValuesFrom>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">clustering algorithm</rdfs:label>
        <skos:example xml:lang="en-US">hierarchical clustering algorithm</skos:example>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">machine learning algorithm that prescribes how a clustering model is generated</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/ClusteringModel -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/ClusteringModel">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningModel"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000110"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/Cluster"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000110"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/DataDescriptionObjective"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningModel"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">clustering model</rdfs:label>
        <skos:example xml:lang="en-US">hierarchical clustering model, k means clustering model</skos:example>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">machine learning model which consists of clusters that are determined by some underlying similarity between a subset of features in the training set that was used to train the model</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/ComplexNumberFeature -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/ComplexNumberFeature">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/NumericalFeature"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">complex number feature</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">numeric feature whose values are complex numbers</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/ComputingProcess -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/ComputingProcess"/>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/ConfigurationSetting -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/ConfigurationSetting">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/InformationContentEntity"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isConfigurationSettingOfAtSomeTime"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/ConfigurationVariable"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/InformationContentEntity"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">configuration variable setting</rdfs:label>
        <skos:example xml:lang="en-US">&quot;4&quot; is the value of a batch size hyperparameter that is set for a particular training of a CNN model</skos:example>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">information content entity that specifies the value of a configuration variable</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/ConfigurationVariable -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/ConfigurationVariable">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/InformationContentEntity"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">configuration variable</rdfs:label>
        <skos:example xml:lang="en-US">batch size for machine learning training, number of neighbors for KNN model generation, weight of a neuron, intercept of a linear regression model</skos:example>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">information content entity whose value influences the output or behavior of an encoded algorithm of which it is a part</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/ConfigurationVariableSet -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/ConfigurationVariableSet">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/InformationContentEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000110"/>
                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/ConfigurationVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">configuration variable set</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">collection of configuration variables that belong to a particular encoded algorithm</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/ConfigurationVariableSettingSet -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/ConfigurationVariableSettingSet">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/InformationContentEntity"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isConfigurationSettingSetOfAtSomeTime"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/ConfigurationVariableSet"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isComposedOf"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/ConfigurationSetting"/>
                            <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/ConfigurationVariableSettingSet"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">configuration variable setting set</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">information content entity that consists of configuration settings that belong to a configuration variable set</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/ContinuousNumericFeature -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/ContinuousNumericFeature">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/NumericalFeature"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">continuous numeric feature</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">numeric feature whose values are real numbers</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/ConvolutionalLayer -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/ConvolutionalLayer">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/NeuralNetworkLayer"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">convolutional layer</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">neural network layer that applies learnable filters to its input and outputs feature maps that capture spatial hierarchies and patterns</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/ConvolutionalNeuralNetwork -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/ConvolutionalNeuralNetwork">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/ArtificialNeuralNetwork"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000110"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/ModelInputRequirementSpecification"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasDimensionNumberValue"/>
                                        <owl:someValuesFrom>
                                            <rdfs:Datatype>
                                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
                                                <owl:withRestrictions rdf:parseType="Collection">
                                                    <rdf:Description>
                                                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</xsd:minInclusive>
                                                    </rdf:Description>
                                                </owl:withRestrictions>
                                            </rdfs:Datatype>
                                        </owl:someValuesFrom>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isComposedOf"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/ConvolutionalLayer"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/ArtificialNeuralNetwork"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">convolutional neural network</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">artificial neural network that is composed primarily of convolutional layers and that requires inputs that have dimensions of at least two</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/DataCleaningAlgorithm -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/DataCleaningAlgorithm">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DataProcessingAlgorithm"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/prescribes"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/EncodedAlgorithm"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isExecutedIn"/>
                                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/DataCleaningOperation"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">data cleaning algorithm</rdfs:label>
        <skos:example xml:lang="en-US">Multiple Imputation by Chained Equations algorithm used to impute the missing values</skos:example>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">data processing algorithm that prescribes how the missing or corrupted entries in a dataset should be corrected</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/DataCleaningObjective -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/DataCleaningObjective">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/ObjectiveSpecification"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isAchievedByAtSomeTime"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/DataCleaningOperation"/>
                            <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/DataCleaningPipeline"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">data cleaning objective</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">objective specification that prescribes the outcome of a data cleaning operation or pipeline</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/DataCleaningOperation -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/DataCleaningOperation">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/DataProcessingOperation"/>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000059"/>
                                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/DataCleaningObjective"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/executed"/>
                                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/EncodedDataCleaningAlgorithm"/>
                            </owl:Restriction>
                        </owl:unionOf>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DataProcessingOperation"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">data cleaning operation</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">data processing operation that detects and corrects a set of corrupt, missing or inaccurate records from a dataset</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/DataCleaningPipeline -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/DataCleaningPipeline">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/DataProcessingPipeline"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000117"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/DataCleaningOperation"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasDataInput"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/IAO_0000100"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasDataOutput"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/PreProcessedDataSet"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DataProcessingPipeline"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">data cleaning pipeline</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">planned process that consists of a number of data cleaning operations through which the input dataset is processed to impute missing and/or remove corrupted values</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/DataDescriptionObjective -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/DataDescriptionObjective">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/ModelExecutionObjective"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">data description objective</rdfs:label>
        <skos:example xml:lang="en-US">use of PCA to identify which tumor types share a similar RNA expression pattern</skos:example>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">model execution objective to describe some underlying characteristic of the input data items</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/DataImputationAlgorithm -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/DataImputationAlgorithm">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DataCleaningAlgorithm"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">data imputation algorithm</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">data cleaning algorithm that prescribes how missing values within some dataset should be replaced</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/DataImputationOperation -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/DataImputationOperation">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/DataCleaningOperation"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/executed"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/EncodedDataCleaningAlgorithm"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/prescribedBy"/>
                                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/DataImputationAlgorithm"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DataCleaningOperation"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">data imputation operation</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">computing process in which missing values are replaced by some encoded data imputation algorithm</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/DataItemCharacteristic -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/DataItemCharacteristic">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/informationContentEntityCharacteristicOf"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/InformationContentEntityCharacteristic"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">data item characteristic</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">information content entity characteristic of a data item</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/DataProcessingAlgorithm -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/DataProcessingAlgorithm">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/Algorithm"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">data processing algorithm</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">algorithm that prescribes how to transform or modify pieces of data</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/DataProcessingOperation -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/DataProcessingOperation">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/ComputingProcess"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:complementOf>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000118"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/DataProcessingOperation"/>
                    </owl:Restriction>
                </owl:complementOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasDataInput"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasDataOutput"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">data processing operation</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">computing process that transforms or modifies input data</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/DataProcessingPipeline -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/DataProcessingPipeline">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/ComputingProcess"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000117"/>
                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/DataProcessingOperation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasDataInput"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/IAO_0000100"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasDataOutput"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/IAO_0000100"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">data processing pipeline</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">computing process that consists of an ordered set of data processing operations through which an input dataset is transformed</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/DataQualityAssesment -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/DataQualityAssesment">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000059"/>
                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/DataQualityMetric"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasDataInput"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/IAO_0000100"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">data quality assessment</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">planned process in which the data quality of a dataset is assessed with respect to one or more quality metrics</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/DataQualityMetric -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/DataQualityMetric">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MathematicalFunction"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">data quality metric</rdfs:label>
        <iof-av:explanatoryNote xml:lang="en-US">1) data quality metrics include metrics for accuracy, data completeness, consistency, and timeliness
2) data quality metrics can be qualitative, quantitative and semi-quantitative</iof-av:explanatoryNote>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">mathematical function that prescribes how to assess the suitability of a dataset for a particular application</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/DataQualityMonitoring -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/DataQualityMonitoring">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000132"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/DeployedMachineLearningModelState"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/occursSimultaneouslyWith"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/DeployedMachineLearningModelState"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/temporallyFinishes"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/DeployedMachineLearningModelState"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/temporallyStarts"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/DeployedMachineLearningModelState"/>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000117"/>
                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/DataQualityAssesment"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">data quality monitoring</rdfs:label>
        <iof-av:explanatoryNote xml:lang="en-US">prior to utilization, the dataset in this context includes either raw or pre-processed datasets</iof-av:explanatoryNote>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">planned process during which data quality is assessed for datasets prior to being utilized for a deployed machine learning model</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/DataReshapingOperation -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/DataReshapingOperation">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DataProcessingOperation"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">data reshaping operation</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">data processing operation that changes the dimensions of one or more datasets or data items</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/DataSetCharacteristic -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/DataSetCharacteristic">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/informationContentEntityCharacteristicOf"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/IAO_0000100"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/InformationContentEntityCharacteristic"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">data set characteristic</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">data item characteristic of a dataset</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/DataSetOrderingScheme -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/DataSetOrderingScheme">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/InformationContentEntityOrderingScheme"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isAbout"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/IAO_0000100"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/prescribes"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/Index"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">data set ordering scheme</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">information content entity ordering scheme that prescribes the ordering of data items within a dataset</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/DateTimeFeature -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/DateTimeFeature">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/Feature"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isValueExpressionOfAtSomeTime"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000008"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/Feature"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">date-time feature</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">feature whose values are dates or times</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/DecisionTreeAlgorithm -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/DecisionTreeAlgorithm">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningTrainingAlgorithm"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/prescribes"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/EncodedAlgorithm"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isExecutedIn"/>
                                <owl:someValuesFrom>
                                    <owl:Class>
                                        <owl:intersectionOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningTraining"/>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput"/>
                                                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/DecisionTreeModel"/>
                                            </owl:Restriction>
                                        </owl:intersectionOf>
                                    </owl:Class>
                                </owl:someValuesFrom>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">decision tree algorithm</rdfs:label>
        <skos:example xml:lang="en-US">ID3, M5, Stump</skos:example>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">machine learning algorithm that prescribes how a decision tree model is generated</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/DecisionTreeModel -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/DecisionTreeModel">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/NonParametricModel"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000110"/>
                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/RegressionObjective"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">decision tree model</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">non-parametric model that is a tree-like graph where each branching present is dependent on a value of some feature present in the training set that was used to train the model</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/DefaultSetting -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/DefaultSetting">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isDefaultSettingOf"/>
                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/ConfigurationVariable"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/ConfigurationSetting"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">default setting</rdfs:label>
        <skos:example xml:lang="en-US">5 neighbors is the default setting for sklearn KNN training algorithm implementation</skos:example>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">configuration variable setting that specifies the default value (value that is used if user does not provide a value) of a configuration variable</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/DeployedMachineLearningModelState -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/DeployedMachineLearningModelState">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000057"/>
                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningParameterSettingSet"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000167"/>
                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/EngineeredSystem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000167"/>
                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningModel"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/meets"/>
                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningModelDeploymentProcess"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">deployed machine learning model state</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">process during which a machine learning model is deployed on a particular engineered system</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/DerivedFeature -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/DerivedFeature">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/Feature"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/dataOutputOf"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/FeatureEngineeringOperation"/>
                                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/FeatureEngineeringPipeline"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/Feature"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">derived feature</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">feature that was created by a set of feature engineering operations</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/DerivedFeatureColumn -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/DerivedFeatureColumn">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/FeatureColumn"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isComposedOf"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/DerivedFeature"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isComposedOf"/>
                <owl:allValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/DerivedFeature"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">derived feature column</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">feature column that has only derived features as parts</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/DigitalImage -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/DigitalImage">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">digital image</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">data item that is a rectangular or cuboid grid of elements (pixels or voxels respectively), whose values are finite, discrete quantities derived from measurements of some quality of a number of entities repeated at regular intervals across a spatial range</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/DimensionalityReductionAlgorithm -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/DimensionalityReductionAlgorithm">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningTrainingAlgorithm"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/prescribes"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/EncodedAlgorithm"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isExecutedIn"/>
                                <owl:someValuesFrom>
                                    <owl:Class>
                                        <owl:intersectionOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/MachineLearningTraining"/>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000057"/>
                                                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/DimensionalityReductionModel"/>
                                            </owl:Restriction>
                                        </owl:intersectionOf>
                                    </owl:Class>
                                </owl:someValuesFrom>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">dimensionality reduction algorithm</rdfs:label>
        <skos:example xml:lang="en-US">randomized SVD solver used to generate a principal component model</skos:example>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">machine learning algorithm that prescribes how a dimensionality reduction model is trained</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/DimensionalityReductionModel -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/DimensionalityReductionModel">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MachineLearningModel"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000110"/>
                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/DataDescriptionObjective"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">dimensionality reduction model</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">machine learning model that prescribes how to map datasets to a space of lower dimension</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/DirectiveInformationContentEntity -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/DirectiveInformationContentEntity"/>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/DiscreteNumericFeature -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/DiscreteNumericFeature">
