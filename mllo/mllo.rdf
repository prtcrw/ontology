        <rdfs:domain rdf:resource="https://spec.industrialontologies.org/ontology/construct/Index"/>
        <rdfs:range rdf:resource="https://spec.industrialontologies.org/ontology/construct/InformationContentEntity"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.industrialontologies.org/ontology/machinelearninglifecycle/MachineLearningLifecycle/"/>
        <rdfs:label xml:lang="en-US">is the index of</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-US">relation from an index to the information content entity whose position it determines</iof-av:naturalLanguageDefinition>
    </owl:ObjectProperty>
    


